{
  "name": "@vraxis/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc -b && npm run build:client && npm run build:server && npm run prerender",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.ts --outDir .prerender",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc -b",
    "check:copy": "node scripts/check-copy.mjs copy/site-copy.md",
    "check": "npm run test && npm run build && npm run check:copy"
  },
  "dependencies": {
    "@vraxis/osx-components": "^0.11.3",
    "vue": "^3.5.21"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/server-renderer": "^3.5.21",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.0.8"
  }
}
